# Server runtime
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed origins. Add your deployed frontend domain.
# Use the literal string *.vercel.app to allow any Vercel preview deployment.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Mongo Atlas connection string (URL encoded, no trailing slash)
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/carRental?retryWrites=true&w=majority

# Long random string used to sign JWTs (at least 32 chars)
ACCESS_TOKEN_SECRET=replace-with-a-very-long-random-string
